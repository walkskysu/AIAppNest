{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "esModuleInterop": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM"], "types": ["node"],
    "paths": {
      "@aiappnest/contracts": ["./packages/contracts/src/index.ts"],
      "@aiappnest/domain": ["./packages/domain/src/index.ts"],
      "@aiappnest/storage": ["./packages/storage/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/types/**/*.ts"]
}
